    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@paypal/react-paypal-js": "^8.7.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.2.0",
    "@types/react": "^18.2.15",
