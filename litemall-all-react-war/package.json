{
  "name": "react-boilerplate",
  "homepage": "/",
  "version": "1.0.0",
  "scripts": {
    "start": "mvn spring-boot:run",
    "webapp:dev": "cross-env NODE_ENV=development webpack serve --config webpack/webpack.config.js",
    "build": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.prod.js",
    "serve": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.prod.js && cross-env serve dist/",
    "build:watch": "concurrently 'npm run webapp:dev -- --watch' npm:backend:start",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src/",
    "clean-www": "rimraf target/classes/static/app",
    "backend:start": "mvn spring-boot:run -Dskip.installnodenpm -Dskip.npm",
    "backend:clean": "mvn clean spring-boot:run -Dskip.installnodenpm -Dskip.npm",
    "// Backend debug": "/**--------- Backend debug section **------------/",
    "backend:debug": "mvn -Dspring-boot.run.jvmArguments=\"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:8000\"",
    "// Backend test": "/**--------- Backend test section **------------/",
    "backend:nohttp:test": "mvn  -ntp checkstyle:check --batch-mode",
    "backend:unit:test": "mvn spring-boot:run -Dskip.installnodenpm -Dskip.npm verify --batch-mode -Dlogging.level.ROOT=OFF -Dlogging.level.org.zalando=OFF -Dlogging.level.tech.jhipster=OFF  -Dlogging.level.org.springframework=OFF -Dlogging.level.org.springframework.web=OFF -Dlogging.level.org.springframework.security=OFF",
    "java:jar": "mvn  -ntp verify -DskipTests --batch-mode"
  },
  "author": "Maciek@strzelbicki.pl",
  "license": "ISC",
  "dependencies": {
    "@coreui/coreui": "^5.2.0",
    "@coreui/icons": "^3.0.1",
