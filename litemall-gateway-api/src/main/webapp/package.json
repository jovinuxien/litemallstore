{
  "name": "@litemall/customer-web",
  "version": "0.1.0",
  "private": true,
  "description": "Customer storefront SPA, served by litemall-gateway-api (same-origin BFF).",
  "scripts": {
    "webapp:dev": "cross-env NODE_ENV=development webpack serve --config webpack/webpack.config.js",
    "webapp:prod": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.prod.js",
    "build": "npm run webapp:prod",
    "test": "jest --config jest.conf.js",
    "i18n:check": "i18next --config i18next-parser.config.js --fail-on-update",
    "i18n:extract": "i18next --config i18next-parser.config.js",
    "backend:deps": "mvn -f ../../../../pom.xml -pl litemall-db -am -DskipTests -Dskip.npm=true install",
    "backend:start": "npm run backend:deps && mvn -f ../../../../pom.xml -pl litemall-gateway-api spring-boot:run -Dskip.npm=true",
    "backend:debug": "npm run backend:deps && mvn -f ../../../../pom.xml -pl litemall-gateway-api spring-boot:run -Dspring-boot.run.jvmArguments=\"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:8000\" -Dskip.npm=true"
  },
  "dependencies": {
    "@litemall/shared": "0.1.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "axios": "^1.5.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "i18next": "^23.16.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-instantsearch": "^7.35.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.3",
    "i18next-parser": "^9.4.0",
    "sass": "^1.54.1",
    "sass-loader": "^13.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.1.6",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
