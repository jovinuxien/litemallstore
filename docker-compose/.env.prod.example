# litemall production secrets — TEMPLATE.
#
#   cp docker-compose/.env.prod.example .env      # repo root, gitignored
#   # fill in every value, then:
#   docker compose -f docker-compose/docker-compose.prod.yml --env-file .env up -d
#
# Every var marked REQUIRED is referenced as ${VAR:?} in the compose file, so a
# missing one ABORTS the run naming the variable, rather than silently starting a
# service with an empty credential. Never commit the filled-in .env.

# ---- Domains / TLS (REQUIRED) ---------------------------------------------
# Caddy is the only container published to the host; it terminates TLS for both
# gateways and gets certs from Let's Encrypt automatically.
#
# LOCAL / STAGING (no public DNS yet): set SHOP_DOMAIN=localhost and
# ADMIN_DOMAIN=localhost:8443 — Caddy issues its own internal-CA cert, so the
# full TLS path is exercisable before the real domain exists.
#
# PROD: real hostnames whose DNS A records already point at this VPS. Caddy
# cannot complete the ACME HTTP-01 challenge before DNS resolves, and repeated
# failures burn Let's Encrypt rate limits (5 certs/domain/week).
SHOP_DOMAIN=
ADMIN_DOMAIN=
# Where Let's Encrypt sends expiry warnings. A silently failed renewal is a full
# outage 90 days later — do not leave this blank in prod.
ACME_EMAIL=

# ACME DNS-01 via Cloudflare. REQUIRED before orange-clouding (proxying) the
# DNS records through Cloudflare's CDN — behind the proxy the HTTP-01 challenge
# can't reach this origin, so cert renewal would silently fail. Set the WHOLE
# directive (the Caddyfile injects this line into its global options; empty ⇒
# staging runs tokenless on the internal CA):
#   CADDY_ACME_DNS=acme_dns cloudflare <token with Zone.DNS:Edit on the zone>
CADDY_ACME_DNS=

# Public origin of the storefront, e.g. https://shop.example.com — must match
# SHOP_DOMAIN. This is the ONLY allowed CORS origin in prod (the default config
# hardcodes the localhost:9000 dev server).
SHOP_ORIGIN=

# ---- MySQL (REQUIRED) -----------------------------------------------------
# The old dev password was committed in 6+ files and is in git history — anyone
# with repo access can read it. Treat it as burned: use a NEW value here, and
# rotate the dev one too. (Deliberately not quoted: writing a live credential
# into a checked-in file is the mistake this whole file exists to undo.)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=litemall
MYSQL_PASSWORD=

# ---- RabbitMQ (REQUIRED) --------------------------------------------------
# Dev default is guest/guest.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ---- JWT signing keys (REQUIRED) ------------------------------------------
# Three independent RSA keypairs: one per realm plus the machine-token issuer.
#
# The authserver pair is the important one. Its committed config sets
# private-key-pem:"" — so today it generates an EPHEMERAL pair on every boot and
# every machine token dies on restart. The two gateway pairs currently in git
# (gateway-api/application.yml:155-183, gateway-admin/bootstrap.yml:48-76) are
# burned: anyone with repo access can mint admin tokens. Generate fresh ones.
#
# Generate a pair (repeat per realm):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out k.pem
#   openssl rsa -in k.pem -pubout -out k.pub
# Then inline as one line, e.g.:
#   AUTHSERVER_JWT_PRIVATE_KEY_PEM="$(awk 'BEGIN{ORS="\\n"}1' k.pem)"
AUTHSERVER_JWT_PRIVATE_KEY_PEM=
AUTHSERVER_JWT_PUBLIC_KEY_PEM=
GATEWAY_API_JWT_PRIVATE_KEY_PEM=
GATEWAY_API_JWT_PUBLIC_KEY_PEM=
GATEWAY_ADMIN_JWT_PRIVATE_KEY_PEM=
GATEWAY_ADMIN_JWT_PUBLIC_KEY_PEM=

# ---- Machine client_credentials secrets (REQUIRED) ------------------------
# Replace the committed dev values that used to live in AuthServerProps.java:16,19.
# They are plaintext by design (NoOpPasswordEncoder), so the literal IS the
# credential — hence not repeated here. They are in git history: treat as burned
# and generate new ones.
GATEWAY_API_CLIENT_SECRET=
GATEWAY_ADMIN_CLIENT_SECRET=

# ---- Stripe (optional until launch) ---------------------------------------
# Absent ⇒ the payment adapter stays disabled, card pay returns a typed error,
# and the SPA hides the card option (no publishable key via /auth/site-config).
# It must NEVER fall back to a fake success. Live keys are a user-side launch
# prerequisite; the webhook secret comes from the Stripe dashboard once the
# public HTTPS URL from Task C exists (locally: `stripe listen` prints one).
# Set all three + STRIPE_ENABLED=true, then `./litemall-prod.sh start`.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- CJ Dropshipping (optional) -------------------------------------------
# Resolve the sprawl: TWO different keys are committed today for the same
# account (goods/order/analytic use 9520bc..., litemall-core uses 8696a1...).
# One value, here.
# Wave 8: order needs BOTH email + key (both blank = CJ disabled with honest
# degradation — paid CJ orders retained + auto-placed when the pair appears;
# exactly one set = order refuses to boot). CJ_OPS_MAIL (optional) receives
# fulfilment-attention mails (terminal CJ rejection / CJ-side cancellation).
CJ_API_KEY=
CJ_EMAIL=
CJ_OPS_MAIL=
# CJ CATALOG credentials (goods-management only): read-only product API access —
# on-demand variant enrichment (a shallow CJ good becomes orderable on first
# view), nightly catalog refresh, product reviews. Safe to set WITHOUT the pair
# above: no CJ order placement happens through these. Usually the same
# email/key as the account's; kept as separate vars so enabling the catalog
# does not silently enable paid fulfilment.
CJ_CATALOG_API_KEY=
CJ_CATALOG_EMAIL=

# ---- Wave-6 marketing (optional; absent ⇒ disabled) -----------------------
MATOMO_AUTH_TOKEN=
MAUTIC_USERNAME=
MAUTIC_PASSWORD=

# ---- seo_plateform keyword research (optional; absent ⇒ disabled) ---------
# Search-demand facts for catalogue copy, read by goods-management through the
# ACL in infrastructure/acl/seo. Credentials are the `litemall-goods` service
# account in the seo realm (client_credentials; the realm hardcodes the tenant
# claim the research service keys its cache, ledger and spend cap on).
#
# ENABLED=false is the honest default and matters more than for the other
# connectors: the platform behind this BUYS each uncached seed from a
# pay-as-you-go provider, billed per seed whether the call succeeds or not.
# Credentials present with the switch off cost nothing.
#
# BASE_URL/TOKEN_URI have no default on purpose. Inside a container "localhost"
# is the container, so a host-run platform needs the host address (172.17.0.1,
# or host.docker.internal with an extra_hosts entry — prod compose has none).
#
# LOCATION 2826 = United Kingdom. The provider accepts ONE language per country
# and Germany is 'de' only, so the DE market cannot answer in English while the
# catalogue's titles and briefs are English.
LITEMALL_SEO_RESEARCH_ENABLED=false
LITEMALL_SEO_RESEARCH_BASE_URL=
LITEMALL_SEO_RESEARCH_TOKEN_URI=
LITEMALL_SEO_RESEARCH_CLIENT_ID=litemall-goods
LITEMALL_SEO_RESEARCH_CLIENT_SECRET=
LITEMALL_SEO_RESEARCH_LOCATION=2826
LITEMALL_SEO_RESEARCH_LANGUAGE=en

# Host directory holding the keyword export, mounted read-only into
# goods-management at /app/seo-export. Only category-keywords-clean.csv is read.
# Without this the container's ${user.home} is the container's own home and the
# provider finds nothing (warns once, serves no keywords, breaks nothing).
LITEMALL_SEO_EXPORT_DIR=
LITEMALL_SEO_RESEARCH_SOURCE=file
