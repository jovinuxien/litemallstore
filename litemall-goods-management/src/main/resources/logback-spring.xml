<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wave 26 (2026-08-15): rewritten after this service was OOM-KILLED in production.

  /app/logs is a tmpfs, and tmpfs pages are charged to the container's memory cgroup, so
  the log file competes with the JVM for the same 1.5 GiB. The previous config combined
  DEBUG on org.linlinjava.litemall with a TimeBasedRollingPolicy that rotates only at
  midnight and caps nothing: 611 MB was written in under two hours, the container sat at
  90.7% of its limit, and the 03:30 enrichment tipped it over.

  Two independent guards now:
    - SIZE-based rolling with an explicit totalSizeCap, so a single day cannot grow
      without bound. Worst case on disk/tmpfs is ~120 MB (100 MB + 20 MB) against the
      256 MB tmpfs cap set in docker-compose.prod.yml.
    - Profile-scoped levels: prod runs at INFO, everything else keeps DEBUG. INFO still
      carries every line the Wave-26 runbooks read (enrichment summaries, price-floor
      off-sales, catalog refresh totals).

  configuration debug="false": logback's own status printer wrote hundreds of lines into
  the very file this config exists to bound.
-->
<configuration debug="false">
    <contextName>logback</contextName>
    <property name="log.path" value="logs" />
    <!-- Archives are gzipped: on a memory-backed tmpfs, every saved page is JVM headroom. -->
    <property name="log.maxFileSize" value="20MB" />
    <property name="log.maxHistory" value="3" />
    <property name="log.totalSizeCap" value="100MB" />
    <property name="log.errorTotalSizeCap" value="20MB" />

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>debug</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %contextName [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/log.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/log-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
            <totalSizeCap>${log.totalSizeCap}</totalSizeCap>
            <!-- tmpfs archives do not survive a restart anyway; sweep them at boot so a
                 crash-loop cannot accumulate them faster than maxHistory prunes. -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>%date %level [%thread] %logger{36} [%file : %line] %msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name="error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
            <totalSizeCap>${log.errorTotalSizeCap}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>%date %level [%thread] %logger{36} [%file : %line] %msg%n
            </pattern>
        </encoder>
        <!-- This file records ERROR level only. -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <root level="ERROR">
        <appender-ref ref="console" />
        <appender-ref ref="file" />
        <appender-ref ref="error" />
    </root>

    <logger name="org.mybatis" level="ERROR" />
    <logger name="org.springframework" level="ERROR" />
    <logger name="org.linlinjava.litemall.core" level="ERROR" />
    <logger name="org.linlinjava.litemall.db" level="ERROR" />

    <!-- Application levels are profile-scoped: the per-request and per-SQL DEBUG lines are
         what filled 611 MB in production, and are exactly what you want on a dev box.
         An explicit logging.level.* property (env or yml) still overrides either branch. -->
    <springProfile name="prod">
        <logger name="org.linlinjava.litemall.admin" level="INFO" />
        <logger name="org.linlinjava.litemall.wx" level="INFO" />
        <logger name="org.linlinjava.litemall.elastic" level="INFO" />
        <logger name="org.linlinjava.litemall.goods" level="INFO" />
        <logger name="org.linlinjava.litemall" level="INFO" />
    </springProfile>
    <springProfile name="!prod">
        <logger name="org.linlinjava.litemall.admin" level="DEBUG" />
        <logger name="org.linlinjava.litemall.wx" level="DEBUG" />
        <logger name="org.linlinjava.litemall.elastic" level="DEBUG" />
        <logger name="org.linlinjava.litemall.goods" level="DEBUG" />
        <logger name="org.linlinjava.litemall" level="DEBUG" />
    </springProfile>
</configuration>
